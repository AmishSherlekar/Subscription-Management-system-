rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for authentication and verified role claims
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        getUserData().role == 'admin'
      );
    }
    
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'staff' || 
        getUserData().role == 'staff' ||
        isAdmin()
      );
    }
    
    function isCustomer() {
      return isAuthenticated() && (
        request.auth.token.role == 'customer' ||
        getUserData().role == 'customer'
      );
    }
    
    function isOwner(customerId) {
      return isAuthenticated() && (
        request.auth.uid == customerId ||
        getUserData().customerId == customerId
      );
    }

    // Users Collection: Only Admin can create/update staff accounts
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStaff());
      allow create, update, delete: if isAdmin();
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if isStaff() || isOwner(customerId);
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Products & Product Variants: Read by authenticated users, Managed by Admin
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Subscription Plans: Read by all, Managed by Admin
    match /plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Tax Rules & Discounts: Managed strictly by Admin
    match /taxRules/{taxId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /discountRules/{discountId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Quotation Templates & Quotations
    match /quotationTemplates/{templateId} {
      allow read, write: if isStaff();
    }

    match /quotations/{quotationId} {
      allow read: if isStaff() || (isCustomer() && isOwner(resource.data.customerId));
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Subscriptions: Staff and Admin manage; Customer can view own and submit requests
    match /subscriptions/{subscriptionId} {
      allow read: if isStaff() || (isCustomer() && isOwner(resource.data.customerId));
      allow create, update: if isStaff();
      // Allow customer to submit renewal/pause request
      allow update: if isCustomer() && isOwner(resource.data.customerId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerRequests', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Invoices: Immutable snapshot history, strictly controlled
    match /invoices/{invoiceId} {
      allow read: if isStaff() || (isCustomer() && isOwner(resource.data.customerId));
      // Invoices generated by Cloud Functions or Staff recording
      allow create: if isStaff();
      // Invoices can only have payment status updated, line item prices are immutable snapshots!
      allow update: if isStaff() && (
        request.resource.data.items == resource.data.items &&
        request.resource.data.billingPeriodKey == resource.data.billingPeriodKey
      );
      allow delete: if isAdmin();
    }

    // Payments: Staff records; Customer can view own payment receipts
    match /payments/{paymentId} {
      allow read: if isStaff() || (isCustomer() && isOwner(resource.data.customerId));
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Billing Execution Jobs & Audit Logs
    match /billingJobs/{jobId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
    }
  }
}
